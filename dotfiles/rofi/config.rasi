/* rofi 2.x — launcher for both tiling sessions (native Wayland under niri,
   X11 under qtile). Deployed by hjem to ~/.config/rofi/config.rasi.
   niri: Mod+D apps, Mod+Shift+C clipboard. qtile: Mod+r apps.
   Reference: man rofi, man rofi-theme */

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "oxygen"; /* same as the GTK/KDE settings */
    terminal: "kitty";
    font: "JetBrainsMono Nerd Font 12";
    drun-display-format: "{name}";
    display-drun: "";
    display-run: "";
    display-window: "";
}

/* Fallback palette (waybar / niri default focus ring); colors.rasi, generated
   from the wallpaper by matugen (`wallpaper`), overrides it when present. */
* {
    bg: #18181bf0;
    bg-alt: #27272a;
    fg: #e4e4e7;
    fg-dim: #a1a1aa;
    accent: #7fc8ff;
    on-accent: #18181b;

    background-color: transparent;
    text-color: @fg;
}
@import "colors.rasi"

window {
    width: 40%;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 8px;
}

mainbox {
    padding: 12px;
    spacing: 10px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 8px 10px;
    spacing: 10px;
    background-color: @bg-alt;
    border-radius: 6px;
    children: [ prompt, entry ];
}

prompt { text-color: @accent; }
entry { placeholder: "Search"; placeholder-color: @fg-dim; }

listview {
    lines: 10;
    columns: 1;
    fixed-height: true;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 6px 10px;
    spacing: 10px;
    border-radius: 6px;
}
element selected { background-color: @accent; text-color: @on-accent; }
element-icon { size: 24px; background-color: inherit; }
element-text { background-color: inherit; text-color: inherit; vertical-align: 0.5; }
