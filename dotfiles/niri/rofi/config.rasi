configuration {
    show-icons: true;
    icon-theme: "oomox-gruvbox-dark";
    display-drun: "Apps";
    font: "Noto Sans 12";
    timeout {
        action: "kb-cancel";
        delay: 0;
    }
}

* {
    bg: #282828;
    bg2: #1d2021;
    fg: #ebdbb2;
    muted: #928374;
    accent: #98971a;
    accent-bright: #b8bb26;
    urgent: #cc241d;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 600px;
    background-color: @bg2;
    border: 2px 2px 2px 2px;
    border-color: @accent;
    border-radius: 10px;
    padding: 16px;
}

inputbar {
    children: [ prompt, entry ];
    padding: 8px 10px;
    background-color: @bg;
    border-radius: 8px;
    margin: 0 0 10px 0;
}

prompt {
    text-color: @accent;
    margin: 0 8px 0 0;
}

entry {
    text-color: @fg;
    placeholder: "search…";
    placeholder-color: @muted;
}

listview {
    background-color: transparent;
    fixed-height: false;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 8px 10px;
    border-radius: 8px;
}

element selected {
    background-color: @accent;
    text-color: @bg2;
}

element-text, element-icon {
    background-color: transparent;
}

element-text selected {
    text-color: @bg2;
}
