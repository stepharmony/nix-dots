{
  "anchor_to_edges": true,
  "icon_theme": "oomox-gruvbox-dark",
  "popup_gap": 12,
  "start": [
    {
      "type": "custom",
      "class": "power",
      "bar": [
        { "type": "button", "label": "\uf011", "class": "power-icon", "on_click": "popup:toggle" }
      ],
      "popup": [
        {
          "type": "box",
          "orientation": "vertical",
          "class": "power-menu",
          "widgets": [
            { "type": "button", "label": "Sleep", "on_click": "systemctl suspend" },
            { "type": "button", "label": "Hibernate", "on_click": "hibernate" },
            { "type": "button", "label": "Shutdown", "on_click": "systemctl poweroff" },
            { "type": "button", "label": "Restart", "on_click": "systemctl reboot" },
            { "type": "button", "label": "Log out", "on_click": "niri msg action quit" }
          ]
        }
      ]
    },
    { "type": "workspaces" },
    {
      "type": "focused",
      "show_icon": true,
      "show_label": true,
      "truncate": { "mode": "end", "max_length": 60 }
    }
  ],
  "center": [
    { "type": "clock", "format": "%a %d.%m %H:%M" }
  ],
  "end": [
    { "type": "music", "player_type": "mpris", "format": "{title} / {artist}", "truncate": { "mode": "end", "max_length": 40 } },
    { "type": "volume" },
    { "type": "notifications" },
    { "type": "tray" }
  ]
}
