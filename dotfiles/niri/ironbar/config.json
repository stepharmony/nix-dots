{
  "anchor_to_edges": true,
  "icon_theme": "oomox-gruvbox-dark",
  "start": [
    { "type": "workspaces" },
    {
      "type": "focused",
      "show_icon": true,
      "show_label": true,
      "truncate": { "mode": "end", "max_length": 60 }
    }
  ],
  "center": [
    { "type": "clock", "format": "%a %d.%m %H:%M" }
  ],
  "end": [
    { "type": "music", "player_type": "mpris" },
    { "type": "volume" },
    { "type": "notifications" },
    { "type": "tray" }
  ]
}
