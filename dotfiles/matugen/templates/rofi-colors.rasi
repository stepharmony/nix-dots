/* Generated by matugen from the current wallpaper (`wallpaper`, nix-dots
   dotfiles/matugen/templates/rofi-colors.rasi). Imported by config.rasi. */
* {
    bg: #{{colors.surface.default.hex_stripped}}f0;
    bg-alt: {{colors.surface_container_high.default.hex}};
    fg: {{colors.on_surface.default.hex}};
    fg-dim: {{colors.on_surface_variant.default.hex}};
    accent: {{colors.primary.default.hex}};
    on-accent: {{colors.on_primary.default.hex}};
}
