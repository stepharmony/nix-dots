// Generated by matugen from the current wallpaper (`wallpaper`, nix-dots
// dotfiles/matugen/templates/niri-colors.kdl). Included by config.kdl.
layout {
    focus-ring {
        active-color "{{colors.primary.default.hex}}"
        inactive-color "{{colors.outline.default.hex}}"
    }
    border {
        active-color "{{colors.tertiary.default.hex}}"
        inactive-color "{{colors.outline_variant.default.hex}}"
    }
}
