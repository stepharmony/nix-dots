// Waybar — Niri session bar (spawned by niri's config.kdl). Deployed by hjem to ~/.config/waybar/config.jsonc.
// Module reference: https://github.com/Alexays/Waybar/wiki
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 6,

    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "network", "custom/refresh", "custom/power", "battery", "tray"],

    "niri/workspaces": {
        "format": "{index}"
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 60
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "scroll-step": 5
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 wired",
        "format-disconnected": "󰤭 offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        // Network list lives in the nm-applet tray icon; this opens the editor.
        "on-click": "nm-connection-editor"
    },

    // Internal panel refresh rate (refresh-rate, modules/hardware/laptop.nix);
    // click toggles 60/120 Hz. Empty (hidden) on manus.
    "custom/refresh": {
        "exec": "refresh-rate status 2>/dev/null",
        "interval": 10,
        "signal": 8,
        "on-click": "refresh-rate toggle",
        "tooltip": false
    },

    // Lenovo platform profile (modules/hardware/laptop.nix); click toggles
    // performance. power-mode only exists on spectre, so on manus the output
    // is empty and waybar hides the module.
    "custom/power": {
        "exec": "power-mode status 2>/dev/null",
        "interval": 5,
        "signal": 9,
        "on-click": "power-mode toggle",
        "tooltip": false
    },

    // Hides itself on manus (no battery there).
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "states": { "warning": 25, "critical": 10 }
    },

    "tray": {
        "spacing": 8
    }
}
