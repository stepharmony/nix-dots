# zathura — PDF viewer for the tiling sessions (Okular stays for annotations).
# Deployed by hjem to ~/.config/zathura/zathurarc. Reference: man zathurarc
# Keys: j/k scroll, J/K pages, +/- zoom, a/s fit, Ctrl+R dark pages, / search.

set selection-clipboard clipboard
set adjust-open "best-fit"
set scroll-page-aware true
set guioptions "sv"
set font "JetBrainsMono Nerd Font 10"

# Wallpaper palette (generated by matugen, `wallpaper`).
include colors
