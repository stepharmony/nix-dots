# Wallpaper-driven theming for the tiling sessions (niri + qtile) — matugen
# turns the wallpaper into a Material You palette and renders every template
# in dotfiles/matugen/templates/ next to the hjem-managed configs, which
# include/import those generated files. Plasma is untouched: GTK and Qt only
# follow the palette where niri/qtile set GTK_THEME=Matugen and
# QT_QPA_PLATFORMTHEME=qt6ct (libadwaita apps ignore GTK_THEME).
#
#   wallpaper <image>   set wallpaper + regenerate + reload running bits
#   wallpaper init      first-login seed (systemd user unit below)
#   wallpaper-pick      rofi thumbnail grid of ~/Pictures/Wallpapers (Mod+W)
{
  pkgs,
  lib,
  username,
  ...
}:
let
  templates = ../../../dotfiles/matugen/templates;
  defaultWallpaper = ../../../dotfiles/niri/wallpaper.png;

  # GTK3 theme "Matugen": adw-gtk3-dark with the libadwaita named colours
  # overridden (the documented way to recolour adw-gtk3). Written here, not
  # in dotfiles/, because it needs adw-gtk3's store path.
  gtkTemplate = pkgs.writeText "matugen-gtk3.css" ''
    /* Generated by matugen from the current wallpaper (`wallpaper`, nix-dots
       modules/desktop/session/_theming.nix). GTK_THEME=Matugen in niri/qtile. */
    @import url("file://${pkgs.adw-gtk3}/share/themes/adw-gtk3-dark/gtk-3.0/gtk.css");

    @define-color accent_color {{colors.primary.default.hex}};
    @define-color accent_bg_color {{colors.primary.default.hex}};
    @define-color accent_fg_color {{colors.on_primary.default.hex}};
    @define-color destructive_color {{colors.error.default.hex}};
    @define-color destructive_bg_color {{colors.error.default.hex}};
    @define-color destructive_fg_color {{colors.on_error.default.hex}};
    @define-color window_bg_color {{colors.surface.default.hex}};
    @define-color window_fg_color {{colors.on_surface.default.hex}};
    @define-color view_bg_color {{colors.surface_container_low.default.hex}};
    @define-color view_fg_color {{colors.on_surface.default.hex}};
    @define-color headerbar_bg_color {{colors.surface_container.default.hex}};
    @define-color headerbar_fg_color {{colors.on_surface.default.hex}};
    @define-color headerbar_backdrop_color @window_bg_color;
    @define-color sidebar_bg_color {{colors.surface_container_low.default.hex}};
    @define-color sidebar_fg_color {{colors.on_surface.default.hex}};
    @define-color card_bg_color {{colors.surface_container.default.hex}};
    @define-color card_fg_color {{colors.on_surface.default.hex}};
    @define-color dialog_bg_color {{colors.surface_container_high.default.hex}};
    @define-color dialog_fg_color {{colors.on_surface.default.hex}};
    @define-color popover_bg_color {{colors.surface_container_high.default.hex}};
    @define-color popover_fg_color {{colors.on_surface.default.hex}};
  '';

  # template -> output (paths next to each app's hjem-managed config)
  outputs = {
    "niri-colors.kdl" = "~/.config/niri/colors.kdl";
    "waybar-colors.css" = "~/.config/waybar/colors.css";
    "rofi-colors.rasi" = "~/.config/rofi/colors.rasi";
    "mako-colors" = "~/.config/mako/colors";
    "dunst-colors.conf" = "~/.config/dunst/dunstrc.d/50-matugen.conf";
    "kitty-colors.conf" = "~/.config/kitty/colors.conf";
    "zathura-colors" = "~/.config/zathura/colors";
    "swaylock-config" = "~/.config/swaylock/config";
    "qtile-colors.json" = "~/.config/qtile/colors.json";
    "qt6ct-colors.conf" = "~/.config/qt6ct/colors/matugen.conf";
    "i3lock-color" = "~/.local/state/wallpaper/i3lock-color";
  };

  matugenConfig = (pkgs.formats.toml { }).generate "matugen.toml" {
    config = { };
    templates =
      lib.mapAttrs' (
        name: output:
        lib.nameValuePair (lib.replaceStrings [ "." ] [ "-" ] name) {
          input_path = "${templates}/${name}";
          output_path = output;
        }
      ) outputs
      // {
        gtk3 = {
          input_path = "${gtkTemplate}";
          output_path = "~/.local/share/themes/Matugen/gtk-3.0/gtk.css";
        };
      };
  };

  wallpaper = pkgs.writeShellApplication {
    name = "wallpaper";
    runtimeInputs = with pkgs; [
      matugen
      procps
      libnotify
      util-linux # setsid
    ];
    text = ''
      state=''${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper
      current=$state/current
      mkdir -p "$state"

      generate() {
        matugen image "$1" -c ${matugenConfig} -m dark --source-color-index 0 -q
        # Stamp = config store path: a switch with new templates regenerates.
        echo ${matugenConfig} >"$state/generated"
      }

      reload() {
        if [[ -n ''${NIRI_SOCKET:-} ]]; then
          pkill -x swaybg || true
          setsid -f swaybg -m fill -i "$current" >/dev/null 2>&1
        fi
        pkill -USR2 -x waybar || true # reload style (niri reloads colors.kdl itself)
        if command -v makoctl >/dev/null; then makoctl reload 2>/dev/null || true; fi
        if command -v dunstctl >/dev/null; then dunstctl reload 2>/dev/null || true; fi
        pkill -USR1 -x kitty || true
        if [[ ''${XDG_CURRENT_DESKTOP:-} == qtile ]] && command -v qtile >/dev/null; then
          qtile cmd-obj -f reload_config >/dev/null 2>&1 || true
        fi
      }

      case ''${1:-} in
        init)
          [[ -e $current ]] || ln -sfn ${defaultWallpaper} "$current"
          if [[ $(cat "$state/generated" 2>/dev/null) != ${matugenConfig} ]]; then
            generate "$current"
          fi
          ;;
        "" | -h | --help)
          echo "usage: wallpaper <image> | init" >&2
          exit 1
          ;;
        *)
          img=$(realpath -e -- "$1")
          ln -sfn "$img" "$current"
          generate "$img"
          reload
          notify-send -t 2000 "Wallpaper" "$(basename "$img") — palette applied" || true
          ;;
      esac
    '';
  };

  # Thumbnails are cached (keyed by path + mtime), so only new images are
  # scaled; the first run over a big folder takes a moment.
  wallpaperPick = pkgs.writeShellApplication {
    name = "wallpaper-pick";
    runtimeInputs = with pkgs; [
      ffmpeg
      libnotify
      rofi
      wallpaper
    ];
    text = ''
      dir=''${WALLPAPER_DIR:-$HOME/Pictures/Wallpapers}
      cache=''${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper-thumbs
      mkdir -p "$cache"

      files=()
      if [[ -d $dir ]]; then
        mapfile -d "" files < <(find -L "$dir" -type f \( -iname '*.jpg' -o -iname '*.jpeg' \
          -o -iname '*.png' -o -iname '*.webp' \) -print0 | sort -z)
      fi
      if ((''${#files[@]} == 0)); then
        notify-send "Wallpaper" "No images in $dir" || true
        exit 1
      fi

      idx=$(for f in "''${files[@]}"; do
        thumb=$cache/$(printf '%s %s' "$f" "$(stat -c %Y "$f")" | sha1sum | cut -c1-40).png
        [[ -e $thumb ]] || ffmpeg -loglevel error -y -i "$f" -vf scale=320:-2 -frames:v 1 "$thumb" || true
        name=''${f##*/}
        printf '%s\0icon\x1f%s\n' "''${name%.*}" "$thumb"
      done | rofi -dmenu -i -show-icons -p wallpaper -format i -theme "$HOME/.config/rofi/wallpaper.rasi") || exit 0

      [[ -n $idx ]] && exec wallpaper "''${files[idx]}"
    '';
  };
in
{
  environment.systemPackages = [
    wallpaper
    wallpaperPick
    pkgs.kdePackages.qt6ct # Qt platform theme the tiling sessions select
  ];

  hjem.users.${username}.xdg.config.files = {
    "rofi/wallpaper.rasi".source = ../../../dotfiles/rofi/wallpaper.rasi;
    # Static: points qt6ct at the generated colour scheme. Not written by the
    # qt6ct GUI (read-only store link) — change it here.
    "qt6ct/qt6ct.conf".text = ''
      [Appearance]
      color_scheme_path=/home/${username}/.config/qt6ct/colors/matugen.conf
      custom_palette=true
      icon_theme=oxygen
      standard_dialogs=default
      style=Fusion
    '';
  };

  # Seed the palette on login before any session starts (first login, or the
  # first login after a switch that changed the templates).
  systemd.user.services.wallpaper-init = {
    description = "Generate the matugen palette for the tiling sessions";
    wantedBy = [ "default.target" ];
    before = [ "graphical-session-pre.target" ];
    serviceConfig = {
      Type = "oneshot";
      ExecStart = "${wallpaper}/bin/wallpaper init";
    };
  };
}
