# Wayland session stack (Niri) — sunsetr blue-light filter
# (redshift-style). Config deployed by hjem to the default
# ~/.config/sunsetr location.
#
# sunsetr's geo mode needs coordinates (without them it exits at startup).
# They come from the system timezone, which automatic-timezoned keeps
# current on spectre: sunsetr-geo-sync looks the zone up in tzdata's
# zone1970.tab (the zone's main city, close enough for sunset times) and
# writes ~/.config/sunsetr/geo.toml, which sunsetr hot-reloads. It runs at
# login and whenever /etc/localtime changes, so travelling just works and
# no location ends up in the repo.
{ pkgs, ... }:

let
  geoSync = pkgs.writeShellApplication {
    name = "sunsetr-geo-sync";
    runtimeInputs = with pkgs; [
      coreutils
      gawk
      procps
    ];
    text = ''
      out=''${SUNSETR_GEO:-''${XDG_CONFIG_HOME:-$HOME/.config}/sunsetr/geo.toml}
      zone=$(readlink -f /etc/localtime)
      zone=''${zone#*/zoneinfo/}

      # zone1970.tab: "CC<TAB>±DDMM[SS]±DDDMM[SS]<TAB>Zone/Name<TAB>..."
      coords=$(awk -F'\t' -v z="$zone" '$3 == z { print $2; exit }' \
        ${pkgs.tzdata}/share/zoneinfo/zone1970.tab)
      if [[ -z $coords ]]; then
        echo "sunsetr-geo-sync: no coordinates for timezone '$zone'; leaving $out" >&2
        exit 0
      fi

      new=$(awk -v c="$coords" -v z="$zone" '
        function deg(s, n) {
          return (substr(s, 1, 1) == "-" ? -1 : 1) * (substr(s, 2, n) + substr(s, 2 + n, 2) / 60 \
            + (length(s) > 3 + n ? substr(s, 4 + n, 2) / 3600 : 0))
        }
        BEGIN {
          match(c, /^[+-][0-9]+/)
          printf "# Generated by sunsetr-geo-sync from the timezone (%s)\n", z
          printf "latitude = %.4f\nlongitude = %.4f\n", deg(substr(c, 1, RLENGTH), 2), deg(substr(c, RLENGTH + 1), 3)
        }')

      # Only touch the file on a real change (sunsetr reloads on every write).
      if [[ $(cat "$out" 2>/dev/null) != "$new" ]]; then
        mkdir -p "$(dirname "$out")"
        printf '%s\n' "$new" >"$out.tmp"
        mv "$out.tmp" "$out"
        # qtile's gammastep (x11.nix) can't hot-reload: stop it, and its
        # gammastep-tz loop restarts it with the new coordinates.
        pkill -x '\.?gammastep(-wrapped)?' 2>/dev/null || true
      fi
    '';
  };
in
{
  environment.systemPackages = [
    pkgs.sunsetr
    geoSync
  ];

  # At login (before the session spawns sunsetr) ...
  systemd.user.services.sunsetr-geo-sync = {
    description = "Derive sunsetr coordinates from the system timezone";
    wantedBy = [ "default.target" ];
    before = [ "graphical-session-pre.target" ];
    serviceConfig = {
      Type = "oneshot";
      ExecStart = "${geoSync}/bin/sunsetr-geo-sync";
    };
  };
  # ... and whenever automatic-timezoned (timedated) swaps /etc/localtime.
  systemd.user.paths.sunsetr-geo-sync = {
    wantedBy = [ "default.target" ];
    pathConfig.PathChanged = "/etc/localtime";
  };
}
